{
  "name": "techpulse-ai",
  "version": "0.1.0",
  "private": true,
  "description": "TechPulse AI — your AI-powered technology intelligence platform. Tech news, releases, AI models & tools, security, timelines and a grounded technology assistant.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db redis",
