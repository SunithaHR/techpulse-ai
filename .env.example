# ── Core ──────────────────────────────────────────────────────────────────────
# PostgreSQL connection (see docker-compose.yml — host port 54329).
DATABASE_URL="postgresql://techpulse:techpulse@localhost:54329/techpulse?schema=public"

# Secret used to sign session JWTs. Change in production (openssl rand -base64 48).
AUTH_SECRET="replace-with-a-long-random-string-please"

# App origin used for links in digests / emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── LLM providers (optional) ──────────────────────────────────────────────────
# When set, the TechPulse AI chat uses a real LLM grounded with platform data.
# Leave unset to use the built-in offline "TechPulse engine" (deterministic,
# retrieval-grounded answers — works with zero external dependencies).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"   # point at OpenRouter/Together/Groq etc.

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ── Optional Redis cache (app works fine without it) ─────────────────────────
REDIS_URL="redis://localhost:16379"

# ── Ingestion ────────────────────────────────────────────────────────────────
# GitHub token (optional, raises API rate limits for release/star fetching).
GITHUB_TOKEN=""
# Default interval for the scheduled worker (cron syntax-ish hours), unused for manual runs.
INGEST_CRON_HOURS="*/6"
